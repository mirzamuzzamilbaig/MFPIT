@article{bazai_exploring_2025,
	title = {Exploring the roles of recorded unprecedented rainfall-runoff characteristics and uplifted riverbeds in the catastrophic 2022 {Pakistan} megaflood},
	volume = {16},
	issn = {16749278},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1674927825000383},
	doi = {10.1016/j.accre.2025.02.003},
	abstract = {Catastrophic floods triggered by extreme monsoonal rainfall have increasingly posed challenges in flood management, particularly in lowincome nations like Pakistan. The 2022 megaflood exposed substantial gaps in understanding the interplay between rainfall, sediment dynamics, and flood amplification processes. This study investigates the causes and impacts of the event, focusing on floodwater sources, geomorphological changes, and future risks and mitigation strategies. A multifaceted approach combined with remote sensing, field observations, hydrometeorological data, and climate models was employed. In JulyeAugust 2022, the lower Hindukush, Koh-e-Suleman, and Kirther ranges experienced rainfall of 200e300 mm, up to 726\% above historical averages (1991e2021). This high-intensity rainfall triggered high-magnitude discharges from approximately 1250 streams, 58 \% of which were primary contributors with discharge at 4000e5000 m3/s for nearly a month, causing 80\%e85\% of downstream damage and expanding the flooded area to 49,711 km2. Some streams recorded 5e6 m flood levels, resulting in sedimentation deposition of 0.8e1 m in residential areas and about 2 m in the streambeds. Deposition downstream and along the Indus River reached 1.5e2 m, intensifying flood risks by reducing channel capacity and increasing water levels during flood events. Streambed uplift and sediment deposition emerged as critical factors amplifying flood magnitude, severity, and inundation, with floodwater levels rising by up to 2.4e3 m in some areas, posing severe risks for future events. These findings highlight the need to revise traditional flood risk models, which often overlook sediment dynamics and underscore the future challenges posed by ongoing sediment deposition and climate change, which are expected to exacerbate flood risks in the coming decades. The study emphasizes the importance of sediment management, river erosion control, and post-event interventions. Prioritizing flood management, enhancing early warning systems, and investing in resilient infrastructure are essential strategies to protect communities and ensure long-term safety.},
	language = {en},
	number = {2},
	urldate = {2026-05-02},
	journal = {Advances in Climate Change Research},
	author = {Bazai, Nazir Ahmed and Cui, Peng and Hussain, Tahir and Zhang, Guo-Tao and Wang, Yan and Akhter, Muhammad Gulraiz and Wang, Hao and Alam, Mehtab},
	month = apr,
	year = {2025},
	pages = {409--424},
	file = {PDF:files/209/Bazai et al. - 2025 - Exploring the roles of recorded unprecedented rainfall-runoff characteristics and uplifted riverbeds.pdf:application/pdf},
}

