target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, you may want to ignore it.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms or submodules:
#Pipfile.lock

# poetry
#   Similar to poetry.lock, poetry.lock can be included in version control.
#   poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock can be included in version control.
#pdm.lock
.pdm-plugins/
.pdm-python/

# PEP 582; used by e.g. github.com/lincolnloop/layman and pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

